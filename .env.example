# Application Settings
APP_NAME=SMM PRIME
APP_ENV=production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to "true" on Render (long-lived process).
# Set to "false" on Vercel (serverless — threads are killed after each request).
ENABLE_SCHEDULER=true

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smm_panel
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_RECYCLE=1800

# Security & JWT Tokens
JWT_SECRET_KEY=generate-a-strong-random-64-char-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VipSmmPro Provider Integration
PROVIDER_API_URL=https://vipsmmpro.com/api/v2
PROVIDER_API_KEY=your_vipsmmpro_api_key_here

# SMMXpert Provider Integration
SMMXPERT_API_URL=https://smmxpert.com/api/v2
SMMXPERT_API_KEY=your_smmxpert_api_key_here

# Pricing Configuration
DEFAULT_MARKUP_PERCENT=50

# Default System Defaults
DEFAULT_CURRENCY=INR
DEFAULT_UPI_ID=smmprime@upi

# ==============================================================================
# Payment Gateway Configurations
# ==============================================================================

# FamGateway (UPI Dynamic Instant QR - FamPay v2 API)
# Official documentation: https://famgateway.in/docs.php
FAMGATEWAY_API_KEY=your_famgateway_api_key_here
FAMGATEWAY_BASE_URL=https://famgateway.in

# Cryptomus (Cryptocurrency Payment Gateway)
# Official documentation: https://doc.cryptomus.com/
CRYPTOMUS_API_KEY=your_cryptomus_api_key_here
CRYPTOMUS_MERCHANT_ID=your_cryptomus_merchant_id_here
CRYPTOMUS_BASE_URL=https://api.cryptomus.com/v1
USD_TO_INR_RATE=88.00

# Binance Pay (Direct Merchant API v2 - 0% gas fee)
# Official documentation: https://merchant.binance.com/en
BINANCE_PAY_API_KEY=your_binance_pay_api_key_here
BINANCE_PAY_SECRET_KEY=your_binance_pay_secret_key_here
BINANCE_PAY_MERCHANT_ID=your_binance_pay_merchant_id_here

# UPI Limits (Backend enforced)
MIN_UPI_DEPOSIT=50.00
MAX_UPI_DEPOSIT=1000.00
