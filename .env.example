# ============================================================
# Yoomo SMM Panel — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env to version control
# ============================================================

# Application Settings
APP_NAME=Yoomo
APP_URL=https://yoomo.in
APP_ENV=production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://yoomo.in,https://www.yoomo.in

# Scheduler (set true on Render; false on Vercel)
ENABLE_SCHEDULER=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/yoomo_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_RECYCLE=1800

# Security & JWT
JWT_SECRET_KEY=generate-a-strong-random-64-char-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VipSmmPro Provider
PROVIDER_API_URL=https://vipsmmpro.com/api/v2
PROVIDER_API_KEY=your_vipsmmpro_api_key_here

# SMMXpert Provider
SMMXPERT_API_URL=https://smmxpert.com/api/v2
SMMXPERT_API_KEY=your_smmxpert_api_key_here

# Pricing
DEFAULT_MARKUP_PERCENT=50

# Defaults
DEFAULT_CURRENCY=INR
DEFAULT_UPI_ID=yoomo@upi

# ==============================================================
# Payment Gateways
# ==============================================================

# FamGateway (UPI Dynamic QR)
FAMGATEWAY_API_KEY=your_famgateway_api_key_here
FAMGATEWAY_BASE_URL=https://famgateway.in

# Cryptomus (Crypto payments)
CRYPTOMUS_API_KEY=your_cryptomus_api_key_here
CRYPTOMUS_MERCHANT_ID=your_cryptomus_merchant_id_here
CRYPTOMUS_BASE_URL=https://api.cryptomus.com/v1
USD_TO_INR_RATE=88.00

# Binance Pay
BINANCE_PAY_API_KEY=your_binance_pay_api_key_here
BINANCE_PAY_SECRET_KEY=your_binance_pay_secret_key_here
BINANCE_PAY_MERCHANT_ID=your_binance_pay_merchant_id_here

# NOWPayments (USDT Direct Crypto Gateway)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
NOWPAYMENTS_IPN_URL=https://yoomo.in/wallet/webhooks/nowpayments


# UPI Deposit Limits
MIN_UPI_DEPOSIT=50.00
MAX_UPI_DEPOSIT=5000.00

# ==============================================================
# SEO & Analytics (optional but recommended)
# ==============================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=your-verification-code-here
